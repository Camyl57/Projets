# Copie ce fichier en .env.local et complète-le (le fichier .env.local n'est jamais publié). Voir le README.

# Google Cloud : clé avec « Places API (New) » activée (serveur uniquement).
GOOGLE_PLACES_API_KEY=

# Supabase : URL du projet et clé « anon » / « publishable » (cette clé est faite pour être publique).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
